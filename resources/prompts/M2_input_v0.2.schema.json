{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "task_id",
    "source_requirements_version",
    "confirmed_requirements_version",
    "control",
    "task",
    "category",
    "requirements",
    "unresolved_items",
    "relevant_materials",
    "plan_context"
  ],
  "properties": {
    "schema_version": {
      "const": "m2.v0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "source_requirements_version": {
      "type": "integer",
      "minimum": 0
    },
    "confirmed_requirements_version": {
      "type": "integer",
      "minimum": 0
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_date"
      ],
      "properties": {
        "current_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "config_version",
        "applicable_fields"
      ],
      "properties": {
        "primary": {
          "enum": [
            "writing",
            "presentation",
            "learning",
            "planning_research",
            "data_analysis",
            "coding",
            "general"
          ]
        },
        "secondary": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "writing",
              "presentation",
              "learning",
              "planning_research",
              "data_analysis",
              "coding",
              "general"
            ]
          }
        },
        "config_version": {
          "type": "string",
          "minLength": 1
        },
        "applicable_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "field",
          "text",
          "kind",
          "strength",
          "scope",
          "source_refs",
          "depends_on"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "user_fact",
              "user_decision",
              "system_suggestion",
              "pending_interpretation"
            ]
          },
          "strength": {
            "enum": [
              "hard",
              "preference"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source_ref"
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unresolved_id",
          "field",
          "scope",
          "description",
          "importance",
          "can_defer",
          "source_refs",
          "depends_on"
        ],
        "properties": {
          "unresolved_id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "const": "can_defer"
          },
          "can_defer": {
            "const": true
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source_ref"
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "relevant_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "role",
          "text"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "user",
              "system"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "plan_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_plan_id",
        "current_plan_version"
      ],
      "properties": {
        "current_plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_plan_version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "interview_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "field",
          "scope",
          "question",
          "disposition",
          "answer_source_id",
          "assessment_status"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "assessment_status": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "answered",
              "skipped",
              "unsure"
            ]
          },
          "answer_source_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "quote"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "title": "M2 input v0.2: compact interview context; m2.v0.1 compatible"
}
