{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "M2 output revision 0.2 extends the m2.v0.1 envelope: source_gap_id may be null for planning discoveries; optional related_requirement_ids link existing requirements. Existing 0.1 outputs remain accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "task_id", "source_requirements_version", "status", "plan", "error"],
  "properties": {
    "schema_version": {"const": "m2.v0.1"}, "request_id": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1},
    "source_requirements_version": {"type": "integer", "minimum": 0}, "status": {"enum": ["ok", "error"]},
    "plan": {"oneOf": [{"$ref": "#/$defs/plan"}, {"type": "null"}]},
    "error": {"oneOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]}
  },
  "$defs": {
    "string_array": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unique_string_array": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "goal": {"type": "object", "additionalProperties": false, "required": ["summary", "audience", "scope"], "properties": {"summary": {"type": "string", "minLength": 1}, "audience": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "summary", "step_ids", "deliverable_ids", "criterion_ids"], "properties": {"requirement_id": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "step_ids": {"$ref": "#/$defs/unique_string_array"}, "deliverable_ids": {"$ref": "#/$defs/unique_string_array"}, "criterion_ids": {"$ref": "#/$defs/unique_string_array"}}},
    "step": {"type": "object", "additionalProperties": false, "required": ["step_id", "order", "title", "purpose", "inputs", "actions", "outputs", "completion_criteria", "depends_on_step_ids", "requirement_ids"], "properties": {"step_id": {"type": "string", "minLength": 1}, "order": {"type": "integer", "minimum": 1}, "title": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "inputs": {"$ref": "#/$defs/string_array"}, "actions": {"$ref": "#/$defs/string_array"}, "outputs": {"$ref": "#/$defs/string_array"}, "completion_criteria": {"$ref": "#/$defs/string_array"}, "depends_on_step_ids": {"$ref": "#/$defs/unique_string_array"}, "requirement_ids": {"$ref": "#/$defs/unique_string_array"}}},
    "deliverable": {"type": "object", "additionalProperties": false, "required": ["deliverable_id", "name", "description", "step_ids", "requirement_ids"], "properties": {"deliverable_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "step_ids": {"$ref": "#/$defs/unique_string_array"}, "requirement_ids": {"$ref": "#/$defs/unique_string_array"}}},
    "criterion": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "text", "requirement_ids"], "properties": {"criterion_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "requirement_ids": {"$ref": "#/$defs/unique_string_array"}}},
    "unresolved": {"type": "object", "additionalProperties": false, "required": ["unresolved_id", "source_gap_id", "description", "impact", "continuable_work", "confirm_by"], "properties": {"unresolved_id": {"type": "string", "minLength": 1}, "source_gap_id": {"type": ["string", "null"], "minLength": 1}, "related_requirement_ids": {"$ref": "#/$defs/unique_string_array"}, "description": {"type": "string", "minLength": 1}, "impact": {"type": "string", "minLength": 1}, "continuable_work": {"type": "string", "minLength": 1}, "confirm_by": {"type": "string", "minLength": 1}}},
    "suggestion": {"type": "object", "additionalProperties": false, "required": ["suggestion_id", "text", "kind", "requires_user_confirmation", "reason"], "properties": {"suggestion_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "kind": {"enum": ["optional_improvement", "scope_change", "cost_or_permission"]}, "requires_user_confirmation": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1}}},
    "key_work": {"type": "object", "additionalProperties": false, "required": ["key_work_id", "title", "step_ids", "goal", "inputs", "outputs", "requirement_ids", "depends_on_key_work_ids", "checkpoints"], "properties": {"key_work_id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "step_ids": {"$ref": "#/$defs/unique_string_array"}, "goal": {"type": "string", "minLength": 1}, "inputs": {"$ref": "#/$defs/string_array"}, "outputs": {"$ref": "#/$defs/string_array"}, "requirement_ids": {"$ref": "#/$defs/unique_string_array"}, "depends_on_key_work_ids": {"$ref": "#/$defs/unique_string_array"}, "checkpoints": {"$ref": "#/$defs/string_array"}}},
    "plan": {"type": "object", "additionalProperties": false, "required": ["goal", "requirement_coverage", "steps", "deliverables", "completion_criteria", "unresolved_items", "suggestions", "key_work"], "properties": {"goal": {"$ref": "#/$defs/goal"}, "requirement_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverage"}}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}, "deliverables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/deliverable"}}, "completion_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}}, "unresolved_items": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}}, "suggestions": {"type": "array", "items": {"$ref": "#/$defs/suggestion"}}, "key_work": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/key_work"}}}},
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "related_input_ids", "recovery_action"], "properties": {"code": {"enum": ["insufficient_input", "unsupported_input", "safety_or_permission", "contract_issue"]}, "message": {"type": "string", "minLength": 1}, "related_input_ids": {"$ref": "#/$defs/unique_string_array"}, "recovery_action": {"type": "string", "minLength": 1}}}
  }
}
